<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <Target Name="CopyToUnity" AfterTargets="Build">
        <ItemGroup>
            <MyOutputFiles Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
        </ItemGroup>
        <Copy
                SourceFiles="@(MyOutputFiles)"
                DestinationFolder="..\WebRPG\Assets\Plugins\"
                SkipUnchangedFiles="true" />
    </Target>

</Project>
